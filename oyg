#!/bin/sh
# oyg — own-your-glass (POSIX sh, runs on BusyBox sh on-device)
#
# Subcommands:
#   oyg list
#   oyg status
#   oyg harden [--dry-run] [--only MODULE]
#   oyg restore [--dry-run] [--only MODULE]
#   oyg verify
#
# Environment:
#   OYG_AGGRESSIVE=1          enable risky modules (services-extra, perms,
#                             remoteone chmod)
#   OYG_FORCE_UNSUPPORTED=1   harden on a webOS older than 10 (untested)
#   OYG_NETWORK_BLOCK=1       opt in to the network module (four layers)
#   OYG_NETWORK_STRICT=1      include STRICT section (ThinQ/voice/AI/LG)
#   OYG_NETWORK_IPBLOCK=1     apply layer 3 (per-IP blackhole routes)
#   OYG_DNS_OVERRIDE=1        rewrite /var/lib/misc/resolv.conf sinkhole
#   OYG_DNS_RESOLVER=1        install on-device sinkhole resolver and hook
#                             it in via a /etc/resolv.conf bind-mount (layer 4)
#   OYG_LOG_INTERVAL=<secs>   logs module clear interval (default 60)
#   OYG_DOMAINS_FILE=<path>   legacy override (unused; blocklists in etc/)

set -u

OYG_HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$OYG_HERE/lib/common.sh"

MODULES_DIR="$OYG_HERE/modules"

usage() {
    cat <<EOF
oyg — own-your-glass hardening toolkit

Usage:
  oyg list
  oyg status [--dry-run]
  oyg harden [--dry-run] [--only MODULE]
  oyg restore [--dry-run] [--only MODULE]
  oyg verify

Environment flags (read by individual modules):
  OYG_AGGRESSIVE=1           enable risky modules (services-extra, perms,
                             remoteone chmod)
  OYG_FORCE_UNSUPPORTED=1    harden on a webOS older than 10, which this
                             toolkit has never been run on
  OYG_NETWORK_BLOCK=1        opt in to the network module (four layers)
  OYG_NETWORK_STRICT=1       include STRICT section (ThinQ/voice/AI/LG)
  OYG_NETWORK_IPBLOCK=1      apply layer 3 (per-IP blackhole routes)
  OYG_DNS_OVERRIDE=1         rewrite /var/lib/misc/resolv.conf sinkhole
  OYG_DNS_RESOLVER=1         install on-device sinkhole resolver (127.0.0.2:53)
                             and hook it in via a /etc/resolv.conf bind-mount
                             (layer 4; no connmand interaction)
  OYG_DNS_FALLBACK=1         also list the real upstream in resolv.conf as a
                             second nameserver (off: lookups only via the sink)
  OYG_POLICY_KEEP="<key>"    policy settings left alone (hbbTV,
                             allowMobileDeviceAccess)
  OYG_LOG_INTERVAL=<secs>    logs module clear interval (default 60)
  OYG_LAUNCHER=1             opt in to the launcher module (ad/promo settings
                             off, pushed apps and their quick cards hidden,
                             push list pruned)
  OYG_LAUNCHER_TRIM=1        also switch the home to the wallpaper layout
                             (apps docked under a wallpaper); or a list of
                             section IDs to hide; 0 = stock layout back;
                             unset = keep as applied
  OYG_LAUNCHER_WALLPAPER=<f> your own picture for the wallpaper layout
                             (default = back to the toolkit's)
  OYG_LAUNCHER_KEEP="<id>"   app IDs the launcher module never hides

Available modules:
  services   stop+kill contentminer/objectdetection/adoverlay/acr/remotediag (and iot-client/pushclient if OYG_AGGRESSIVE=1); also handles luna-launched LS2 services
  capture    neutralise /tmp/capture.rgb screen leak + vtCaptureTestSuite
  debloat    stop+kill unused feature services; bind-neutralise preloaded voice-app binary
  mic        mute capture gain (where permitted)
  logs       periodic clear of /tmp/var/log/messages and /tmp/app.voice.log
  network    four-layer mitigation (see docs/DOCUMENTATION.md, "Network module") — layer 1 emits dual-stack (IPv4 + IPv6) hosts-file sinkholes; layer 4 (opt-in OYG_DNS_RESOLVER=1) installs an on-device sinkhole resolver on 127.0.0.2:53 and bind-mounts /etc/resolv.conf over it (no connmand interaction; auto-revert timer on apply)
  perms      chmod webOSbrew hbchannel + Google Home runtime (aggressive)
  remoteone  verify vendor remote-support gate absence

Every action is idempotent and reversible. Every mutation is logged.
EOF
}

all_modules() {
    for f in "$MODULES_DIR"/*.sh; do
        [ -f "$f" ] || continue
        basename "$f" .sh
    done
}

list_modules() {
    printf '%s\n' "Module      What it does"
    printf '%s\n' "-------     ------------------------------------------------"
    for m in $(all_modules); do
        case "$m" in
            services)
                printf 'services    stop+kill contentminer, objectdetection, adoverlay, acr, remotediag (+ iot-client, pushclient if OYG_AGGRESSIVE=1); handles luna-launched LS2 services via per-spec (id|unit|process)\n' ;;
            capture)
                printf 'capture     chattr+immutable / chmod+watcher on /tmp/capture.rgb; mount --bind /dev/null on vtCaptureTestSuite (vendor ro)\n' ;;
            debloat)
                printf 'debloat     stop+kill mycar/familycare/buddyconnector/alwaysready/ai-inference-manager/avahi-{daemon,adaptor}/ruleengine/service-logger/rdxd/dmost/ninfod/cups-lpd + wowplay (Type=static, sticks); bind-neutralise /usr/bin/com.webos.app.voice + iconnectivity + uploadd + sportsalarm + amazon-alexa-adapter + performer + nlpmanager + familycare index.js (+ iot-client with aggressive services); re-applied every boot. sdx and ss.gateway are left alone (F42, F48)\n' ;;
            mic)
                printf 'mic         chmod 000 + mount --bind /dev/null over each ALSA capture PCM (pcmC*D*c); playback preserved\n' ;;
            logs)
                printf 'logs        periodic clear of /tmp/var/log/messages + /tmp/app.voice.log (damage limitation)\n' ;;
            network)
                printf 'network     four-layer mitigation: /etc/hosts bind-overlay (dual-stack IPv4+IPv6 sinkhole) + resolver blackhole (+ per-IP if OYG_NETWORK_IPBLOCK=1) + on-device sinkhole resolver on 127.0.0.2:53 hooked in via a /etc/resolv.conf bind-mount (opt-in OYG_DNS_RESOLVER=1)\n' ;;
            perms)
                printf 'perms       chmod webOSbrew hbchannel + Google Home runtime paths (opt-in, OYG_AGGRESSIVE=1)\n' ;;
            remoteone)
                printf 'remoteone   verify /mnt/lg/cmn_data/remoteDebug/ absent; optionally tighten cmn_data (aggressive)\n' ;;
            apps)
                printf 'apps        hide a curated list of unwanted apps from the launcher via LG blockedSystemAppList/<REGION>.json (ad machinery, remote-support, SDK examples, demo apps); preserves existing entries; skips IDs absent on device\n' ;;
            policy)
                printf 'policy      touch /var/luna/preferences/webosbrew_block_updates (webOSbrew fallback hosts-bind) and webosbrew_telnet_disabled (suppresses telnetd — unauthenticated root on the LAN); force-decline LG consents in /var/luna/preferences/eula (Job B, decline-all default; OYG_TOS_IDS="S_VNG S_TAG" allow-list supported) and the three SDX/ACR-side stores at /mnt/lg/{cmn_data,cache,user}/sdp/eula-service/eula.json (Job C, A→D for every managementTypeCode); move marketingAllowedDate.json aside (Job D — kills the 2-year "re-allow marketing" toast); HbbTV and SSAP off, port 3001 localhost-only (Job E); LG ad cookie emptied (Job F); re-applied every boot\n' ;;
            voice)
                printf 'voice       chmod 000 + mount --bind /dev/null over voiceinput_hidraw / voiceinput / voiceconductor (Magic Remote mic); /dev/hidraw0 untouched\n' ;;
            launcher)
                printf 'launcher    opt-in (OYG_LAUNCHER=1) — LG ad/promo/tips/sports-alert settings off; pushed apps (stubs, Rakuten TV, LG Streaming Week) hidden from the app bar with their quick cards; push list pruned; OYG_LAUNCHER_TRIM=1 also switches to the wallpaper layout; re-applied every boot\n' ;;
            *)
                printf '%s\n' "$m" ;;
        esac
    done
}

load_module() {
    m=$1
    f="$MODULES_DIR/$m.sh"
    if [ ! -f "$f" ]; then
        err "no such module: $m"
        return 1
    fi
    # A syntax error in a sourced file ends the whole shell, so one module
    # this shell cannot parse would stop a restore before the rest ran.
    if ! sh -n "$f" 2>/dev/null; then
        err "module $m does not parse under this shell — skipped: $(sh -n "$f" 2>&1 | head -n 1)"
        return 1
    fi
    . "$f"
}

cmd_list() {
    list_modules
}

cmd_status() {
    OYG_DRY_RUN=0
    [ "${1:-}" = "--dry-run" ] && OYG_DRY_RUN=1
    export OYG_DRY_RUN
    if [ -w "${OYG_ROOT%/*}" ] 2>/dev/null; then
        ensure_dirs 2>/dev/null || true
    fi
    printf '%s\n' "== own-your-glass status =="
    for m in $(all_modules); do
        load_module "$m" || continue
        printf '[%s]\n' "$m"
        func="mod_${m}_status"
        if type "$func" >/dev/null 2>&1; then
            # status functions are read-only queries. Do NOT force dry-run here:
            # doing so makes them report simulated values (e.g. every systemd unit
            # looks "present") instead of real device state.
            "$func" || true
        else
            print_status N/A "no status fn"
        fi
    done
}

run_modules() {
    action=$1; only=$2; dry=$3
    OYG_DRY_RUN=$dry
    export OYG_DRY_RUN
    if { [ "$action" = "harden" ] || [ "$action" = "restore" ]; } && [ "$dry" != "1" ]; then
        require_root
    fi
    # restore stays available everywhere: it is the way back.
    if [ "$action" = "harden" ] && [ "$dry" != "1" ] && ! oyg_supported; then
        err "$OYG_UNSUPPORTED — not hardening this TV ('oyg restore' still works)"
        exit 1
    fi
    ensure_dirs
    if { [ "$action" = "harden" ] || [ "$action" = "restore" ]; } && [ "$dry" != "1" ]; then
        oyg_run_lock || exit 1
    fi

    mods=$(all_modules)
    if [ -n "$only" ]; then
        mods=$only
        found=0
        for m in $mods; do
            if [ -f "$MODULES_DIR/$m.sh" ]; then
                found=1
            fi
        done
        if [ "$found" = "0" ]; then
            err "no such module: $only"
            exit 1
        fi
    fi

    rc=0
    for m in $mods; do
        load_module "$m" || { [ "$action" = "restore" ] && rc=1; continue; }
        func="mod_${m}_${action}"
        if type "$func" >/dev/null 2>&1; then
            printf '\n== %s: %s ==\n' "$m" "$action"
            # <module>.wanted is what the boot hook re-applies: set by
            # harden, dropped by restore, so Undo survives a reboot.
            [ "$dry" = "1" ] || [ "$action" != "harden" ] || state_put "$m.wanted" 1
            if ! "$func"; then
                warn "module $m returned non-zero"
                # A failed restore is reported (exit 1): uninstall.sh then
                # keeps the backups instead of deleting them.
                [ "$action" = "restore" ] && rc=1
            fi
            [ "$dry" = "1" ] || [ "$action" != "restore" ] || state_drop "$m.wanted"
        else
            warn "module $m has no $action function"
        fi
    done
    return $rc
}

cmd_verify() {
    bad=0
    for m in $(all_modules); do
        load_module "$m" || continue
        out=$("mod_${m}_status" 2>&1 || true)
        if printf '%s' "$out" | grep -Eq '^(FAIL|PARTIAL) '; then
            bad=$((bad + 1))
            printf '[%s] not fully applied:\n' "$m"
            printf '%s\n' "$out"
        fi
    done
    if [ "$bad" -gt 0 ]; then
        err "verify: $bad module(s) not fully applied"
        exit 2
    fi
    ok "verify: all applied modules are OK or N/A"
}

main() {
    sub=${1:-}
    [ $# -gt 0 ] && shift || true

    dry=0
    only=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) dry=1 ;;
            --only)    shift; only=${1:-} ;;
            -h|--help) usage; exit 0 ;;
            *) err "unknown arg: $1"; usage; exit 64 ;;
        esac
        shift
    done

    case "$sub" in
        list)     cmd_list ;;
        status)   cmd_status "$@" ;;
        harden)   run_modules harden "$only" "$dry" ;;
        restore)  run_modules restore "$only" "$dry" || exit 1 ;;
        verify)   cmd_verify ;;
        ""|help|-h|--help) usage ;;
        *) err "unknown subcommand: $sub"; usage; exit 64 ;;
    esac
}

main "$@"
